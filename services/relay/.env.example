# FustAI Harness relay. Devices are partitioned by the FustAI account that
# presented a valid account token; there is no password or shared account.
DSH_RELAY_FUSTAI_ORIGIN=https://account.fustai.com

DSH_SERVER_HOST=127.0.0.1
DSH_SERVER_PORT=8080
# Public HTTPS origin clients use; must match scheme/hostname/port exactly.
DSH_SERVER_PUBLIC_URL=https://relay.example.com
DSH_SERVER_DATA_FILE=./data/state.json

# Comma-separated trusted reverse-proxy peer IPs (bare literals only). The proxy
# must overwrite X-Forwarded-For, and the backend must not be publicly reachable.
DSH_SERVER_TRUSTED_PROXY_IPS=

# Optional tuning. Values outside their ranges are ignored with a warning.
DSH_SERVER_HELLO_TIMEOUT_MS=5000
DSH_SERVER_HEARTBEAT_INTERVAL_MS=25000
DSH_SERVER_HEARTBEAT_DISCONNECT_MS=75000
DSH_SERVER_FORCE_TERMINATE_GRACE_MS=1000
DSH_SERVER_LOG_LEVEL=info

# Optional WebRTC. Leave STUN/TURN empty for Relay-only transport: clients fall
# back to the encrypted relay whenever a direct path is unavailable.
DSH_SERVER_STUN_URLS=
DSH_SERVER_TURN_URLS=
DSH_SERVER_TURN_SECRET=
DSH_SERVER_TURN_USERNAME=
DSH_SERVER_TURN_PASSWORD=
DSH_SERVER_TURN_TTL_SECONDS=300